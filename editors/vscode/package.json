{
  "name": "grokmap",
  "displayName": "Grok-map: who understands this code?",
  "description": "See which AI-written code nobody on your team understands, and fix it with a 2-minute quiz. A dashboard in the sidebar, colours in the gutter, quizzes run by VS Code's AI or your own assistant.",
  "version": "0.7.0",
  "publisher": "aadithya-kl",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://aadithya-kl.github.io/grokmap/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aadithya-kl/grokmap",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/Aadithya-kl/grokmap/issues"
  },
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "claude code",
    "code review",
    "comprehension debt",
    "copilot",
    "cursor",
    "dashboard",
    "git blame",
    "kilo code",
    "mcp",
    "quiz"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grokmap.openPanel",
        "title": "Open panel",
        "category": "Grok-map",
        "icon": "media/activity.svg"
      },
      {
        "command": "grokmap.openPanelInEditor",
        "title": "Open in editor tab",
        "category": "Grok-map",
        "icon": "$(link-external)"
      },
      {
        "command": "grokmap.chooseRepo",
        "title": "Choose repository\u2026",
        "category": "Grok-map",
        "icon": "$(repo)"
      },
      {
        "command": "grokmap.refreshPanel",
        "title": "Refresh panel",
        "category": "Grok-map",
        "icon": "$(refresh)"
      },
      {
        "command": "grokmap.quizNobodyChecked",
        "title": "Quiz me on code nobody checked",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.installCli",
        "title": "Install the Grok-map command-line tool",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.welcome",
        "title": "Get started",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.quiz",
        "title": "Quiz me on this file",
        "category": "Grok-map",
        "icon": "$(mortar-board)"
      },
      {
        "command": "grokmap.quizBrief",
        "title": "Copy a quiz brief for my AI assistant",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.who",
        "title": "Who understands this file?",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.toggle",
        "title": "Toggle gutter colours",
        "category": "Grok-map"
      },
      {
        "command": "grokmap.refresh",
        "title": "Refresh gutter",
        "category": "Grok-map"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "grokmap.quiz",
          "group": "grokmap"
        }
      ],
      "explorer/context": [
        {
          "command": "grokmap.quiz",
          "when": "!explorerResourceIsFolder",
          "group": "grokmap"
        }
      ],
      "view/title": [
        {
          "command": "grokmap.refreshPanel",
          "when": "view == grokmap.panel",
          "group": "navigation@1"
        },
        {
          "command": "grokmap.chooseRepo",
          "when": "view == grokmap.panel",
          "group": "navigation@2"
        },
        {
          "command": "grokmap.openPanelInEditor",
          "when": "view == grokmap.panel",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Grok-map",
      "properties": {
        "grokmap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Grok-map colours in the gutter."
        },
        "grokmap.command": {
          "type": "string",
          "default": "grokmap",
          "markdownDescription": "Command that runs Grok-map. Use `uvx grokmap` if you don't want to install it, or a full path such as `/home/me/.local/bin/grokmap`."
        },
        "grokmap.tintLines": {
          "type": "boolean",
          "default": false,
          "description": "Also tint the background of AI-written lines, not just the gutter."
        },
        "grokmap.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the file's comprehension debt in the status bar."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grokmap",
          "title": "Grok-map",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "grokmap": [
        {
          "type": "webview",
          "id": "grokmap.panel",
          "name": "Overview",
          "icon": "media/activity.svg",
          "contextualTitle": "Grok-map"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Grok-map",
        "description": "Find the AI-written code nobody on your team understands, and fix it with a 2-minute quiz.",
        "steps": [
          {
            "id": "install",
            "title": "Install the Grok-map tool",
            "description": "Grok-map reads your git history with a small command-line tool. One click installs it with uv or pip.\n[Install for me](command:grokmap.installCli)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:grokmap.cliReady"
            ]
          },
          {
            "id": "repo",
            "title": "Pick a repository",
            "description": "Open the Grok-map panel and choose any git repository. It doesn't need to be open as a folder.\n[Choose a repository](command:grokmap.chooseRepo)",
            "media": {
              "markdown": "media/walkthrough/repo.md"
            },
            "completionEvents": [
              "onCommand:grokmap.chooseRepo",
              "onView:grokmap.panel"
            ]
          },
          {
            "id": "quiz",
            "title": "Take your first quiz",
            "description": "Three questions on code an AI wrote. Questions are written and graded by the AI model you already have in VS Code, or by your coding assistant.\n[Quiz me on code nobody checked](command:grokmap.quizNobodyChecked)",
            "media": {
              "markdown": "media/walkthrough/quiz.md"
            },
            "completionEvents": [
              "onContext:grokmap.quizDone"
            ]
          },
          {
            "id": "share",
            "title": "Share it with your team",
            "description": "Your result is saved in .grokmap/ledger.jsonl. Commit it (the panel has a button) and the whole team's gutter turns green for that code.",
            "media": {
              "markdown": "media/walkthrough/share.md"
            },
            "completionEvents": [
              "onContext:grokmap.quizDone"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/model.test.js out/test/panelModel.test.js out/test/extension.test.js out/test/panel.test.js",
    "package": "npm run compile && vsce package --no-dependencies -o grokmap.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "~5.9.0"
  }
}
